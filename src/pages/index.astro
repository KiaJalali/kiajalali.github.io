---
import Layout from '../layouts/Layout.astro';
const experience = [
  { company: 'Google', team: 'YouTube · Creator Studio', note: '', role: 'Current', url: 'https://www.google.com' },
  { company: 'Bloomberg', team: 'Core Data', note: 'Data lakehouse infrastructure.', role: 'Previous', url: 'https://www.bloomberg.com' },
  { company: 'Snap', team: 'Monetization · Ad Attribution', note: '', role: 'Internship', url: 'https://www.snap.com' },
  { company: 'Amazon', team: 'Alexa C++ SDK / AWS', note: '', role: 'Two internships', url: 'https://aws.amazon.com' },
  { company: 'DRW', team: 'Event Driven Trading · R&D', note: '', role: 'Internship', url: 'https://drw.com' },
  { company: 'SAP', team: 'Internal Tooling', note: '', role: 'Internship', url: 'https://www.sap.com' },
];
---
<Layout>
  <main id="main">
    <h1 class="sr-only">Kia Jalali</h1>
    <section class="intro" aria-label="About Kia">
      <p>I'm currently at <a href="https://www.google.com">Google</a>, working on YouTube Creator Studio.</p>
      <p>Before that, I worked on Bloomberg's data lakehouse with Iceberg, Trino, and Spark. I've also worked on ad attribution at Snap and research infrastructure at DRW.</p>
      <p>I'm interested in storage, distributed systems, and performance engineering. I studied computer science at <a href="https://www.sfu.ca">SFU</a>.</p>
    </section>
    <section class="work" aria-labelledby="work-title">
      <h2 id="work-title"><span aria-hidden="true">/</span> work</h2>
      <div class="work-table">
        {experience.map((item) => <article class:list={['work-row', { active: item.role === 'Current' }]}><div class="work-company"><a href={item.url}>{item.company}</a><span class="role">{item.role === 'Current' ? 'now' : item.role === 'Previous' ? 'prev' : item.role === 'Two internships' ? 'intern ×2' : 'intern'}</span></div><div class="work-detail"><span>{item.team}</span>{item.note && <span class="work-note">{item.note}</span>}</div></article>)}
      </div>
    </section>
    <p class="email-line">You can reach me at <a href="mailto:kia.jjalali@gmail.com">kia.jjalali@gmail.com</a>.</p>
  </main>
</Layout>
