---
import Layout from '../layouts/Layout.astro';
const experience = [
  { company: 'Google', team: 'YouTube · Creator Studio', note: '', role: 'Current', url: 'https://www.google.com' },
  { company: 'Bloomberg', team: 'Core Data', note: 'Data lakehouse infrastructure.', role: 'Previous', url: 'https://www.bloomberg.com' },
  { company: 'Snap', team: 'Monetization · Ad Attribution', note: '', role: 'Internship', url: 'https://www.snap.com' },
  { company: 'Amazon', team: 'Alexa C++ SDK / AWS', note: '', role: 'Two internships', url: 'https://aws.amazon.com' },
  { company: 'DRW', team: 'Event Driven Trading · R&D', note: '', role: 'Internship', url: 'https://drw.com' },
  { company: 'SAP', team: 'Internal Tooling', note: '', role: 'Internship', url: 'https://www.sap.com' },
];
---
<Layout>
  <main id="main" class="profile">
    <div class="identity">
      <h1>Kia Jalali</h1>
      <p>Software engineer</p>
      <a class="identity-email" href="mailto:kia.jjalali@gmail.com">Get in touch</a>
    </div>
    <div class="profile-content">
      <section class="intro" aria-label="About">
        <p>I'm currently a software engineer at Google, working on YouTube Creator Studio.</p>
        <p>Before Google, I worked on Bloomberg's data lakehouse, building infrastructure for storing and querying datasets with Iceberg, Trino, and Spark. Earlier, I worked on ad attribution at Snap and research infrastructure at DRW.</p>
        <p>My interests are mostly in storage, distributed systems, and performance engineering. I studied computer science at <a href="https://www.sfu.ca">Simon Fraser University</a>.</p>
      </section>
      <section class="experience" aria-labelledby="work-title">
        <h2 id="work-title">Experience</h2>
        <div class="experience-list">
          {experience.map((item) => <article class="experience-row"><div class="company-line"><a class="company" href={item.url}>{item.company}</a><span class:list={['role', { current: item.role === 'Current' }]}>{item.role === 'Current' && <span class="status" aria-hidden="true" />}{item.role}</span></div>{item.team && <p class="team">{item.team}</p>}{item.note && <p class="work-note">{item.note}</p>}</article>)}
        </div>
      </section>
      <div class="contact-line"><a href="mailto:kia.jjalali@gmail.com">kia.jjalali@gmail.com</a></div>
    </div>
  </main>
</Layout>
