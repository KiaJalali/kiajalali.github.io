---
const { direction = 'diagonal' } = Astro.props;
const paths = { diagonal: 'M5 19 19 5M5 5h14v14', up: 'M12 20V4M5 11l7-7 7 7', left: 'M20 12H4m7-7-7 7 7 7' };
---
<svg class="arrow-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[direction as keyof typeof paths] || paths.diagonal} /></svg>
